!/lib/Aurie/AurieCore.dll
!/lib/Aurie/AuriePatcher.exe
!/lib/YYToolkit/YYToolkit.dll
!/lib/UndertaleModLib/UndertaleModLib.dll
!/lib/UndertaleModLib/Underanalyzer.dll
!/lib/MSL/UndertaleModLib.dll
!/lib/MSL/ModShardLauncher.dll
!/lib/MSL/UndertaleModTool.dll
!/lib/MSLE/**/*.dll
