// A mod's page of the skills menu (o_skill_category_stonemod, in its Mods group): StoneForge sets what it shows -
// its name (text, a key of global.tier_name), its skills' icon objects and its background
// (scr_stonemod_skill_category_setup), before it makes its icons (its alarm 0, next step). Empty until then.
event_inherited()
text = "stonemod"
skill = ["1"]
branch_sprite = s_basic_branch
