<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- (Not ModShardLauncher: that's MSL's own assembly, copied beside this one, which mods' references resolve to.
         MSL is a WPF app, so its types need the desktop framework loaded.) -->
    <AssemblyName>StoneForge.MslHost</AssemblyName>
    <RootNamespace>StoneForge.MslHost</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ModShardLauncher"><HintPath>..\lib\MSL\ModShardLauncher.dll</HintPath></Reference>
    <Reference Include="UndertaleModLib"><HintPath>..\lib\MSL\UndertaleModLib.dll</HintPath></Reference>
    <!-- (MSL uses UndertaleModTool's room-layer helpers - its disclaimer room.) -->
    <Reference Include="UndertaleModTool"><HintPath>..\lib\MSL\UndertaleModTool.dll</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
  </ItemGroup>
</Project>
